<!-- Fail-safe companion tree for Humble's always-present navigator plugin. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateThroughPosesForwardAckermann">
      <RateController hz="1.0">
        <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
